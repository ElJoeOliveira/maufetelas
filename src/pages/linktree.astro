---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Maufe Telas — Links Úteis" 
  description="Acesse nossos canais oficiais, confira as avaliações de clientes e solicite seu orçamento de redes de proteção e telas mosquiteiras em MS."
  robots="index, follow"
>
  <div class="relative min-h-screen flex items-center justify-center bg-slate-50 font-sans py-12 px-4 overflow-hidden">
    
    <!-- Padrão de Grade (Representando a Tela de Proteção) -->
    <div class="grid-pattern"></div>
    
    <!-- Gradiente Radial Suave para Fusão de Fundo -->
    <div class="radial-fade"></div>

    <!-- Círculos de Gradiente Abstratos no Fundo para dar Atmosfera (Efeito Premium) -->
    <div class="absolute -top-40 -left-40 w-96 h-96 bg-blue-100/40 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-emerald-50/50 rounded-full blur-3xl pointer-events-none"></div>
    
    <!-- Card Centralizado com Efeito Glassmorphic Premium -->
    <div class="linktree-card">
      
      <!-- Cabeçalho (Logo & Título) -->
      <header class="w-full flex flex-col items-center mb-8">
        <a href="/" class="inline-block mb-5 animate-fade-in-up hover:scale-105 transition-transform duration-300">
          <img 
            src="/referencias/imagens/C_Logo-Maufe-600px.png" 
            alt="Logo Maufe Telas" 
            class="h-12 w-auto object-contain mx-auto"
            draggable="false"
          />
        </a>
        
        <!-- Título Principal Centralizado com Tipografia Outfit -->
        <h1 class="text-slate-700 text-sm sm:text-base font-bold tracking-wide leading-relaxed font-display text-center px-4 animate-fade-in-up delay-100">
          Proteção com design, segurança e exclusividade
        </h1>
      </header>

      <!-- Seção Principal de Links -->
      <main class="w-full space-y-4 mb-8 flex flex-col items-center">
        
        <!-- Botão 1: Avaliações do Google -->
        <a 
          href="https://g.page/r/CYs-IxVUR_ymEAE/review" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="animate-fade-in-up delay-200 btn-linktree bg-brand-dark text-white rounded-2xl shadow-lg hover:bg-[#16365b] hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-200 ease-out group"
        >
          <!-- Ícone Lado Esquerdo (Fundo Transparente) -->
          <div class="btn-icon-wrapper shrink-0 group-hover:scale-110 transition-transform duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-400 fill-current" viewBox="0 0 24 24">
              <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
            </svg>
          </div>

          <!-- Texto Alinhado à esquerda -->
          <div class="flex-grow px-4 text-left">
            <span class="block text-sm font-semibold tracking-wide leading-tight text-white font-sans">Veja o que nossos clientes dizem</span>
            <span class="block text-[10px] text-white/70 font-normal mt-0.5 leading-tight font-sans">Avaliações reais de quem já contratou nossos serviços no Google.</span>
          </div>

          <!-- Seta Indicadora Lado Direito -->
          <div class="text-white/60 group-hover:text-white group-hover:translate-x-1 transition-all duration-300 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </a>

        <!-- Botão 2: Site Oficial -->
        <a 
          href="https://maufetelas.com.br/" 
          class="animate-fade-in-up delay-300 btn-linktree bg-brand-dark text-white rounded-2xl shadow-lg hover:bg-[#16365b] hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-200 ease-out group"
        >
          <!-- Ícone Lado Esquerdo (Fundo Transparente) -->
          <div class="btn-icon-wrapper shrink-0 group-hover:scale-110 transition-transform duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-blue-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
          </div>

          <!-- Texto Alinhado à esquerda -->
          <div class="flex-grow px-4 text-left">
            <span class="block text-sm font-semibold tracking-wide leading-tight text-white font-sans">Conheça nosso site oficial</span>
            <span class="block text-[10px] text-white/70 font-normal mt-0.5 leading-tight font-sans">Acesse mais informações sobre nossos serviços, diferenciais e tipos de instalação.</span>
          </div>

          <!-- Seta Indicadora Lado Direito -->
          <div class="text-white/60 group-hover:text-white group-hover:translate-x-1 transition-all duration-300 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </a>

        <!-- Botão 3: WhatsApp -->
        <a 
          href="https://api.whatsapp.com/send?phone=5567991355250&text=Ol%C3%A1!%20Vi%20o%20perfil%20da%20Maufe%20Telas%20e%20quero%20solicitar%20um%20projeto%20personalizado." 
          target="_blank"
          rel="noopener noreferrer"
          class="animate-fade-in-up delay-400 btn-linktree bg-brand-dark text-white rounded-2xl shadow-lg hover:bg-[#16365b] hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-200 ease-out group"
        >
          <!-- Ícone Lado Esquerdo (Fundo Transparente) -->
          <div class="btn-icon-wrapper shrink-0 group-hover:scale-110 transition-transform duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 fill-current text-emerald-400" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.455L0 24zm6.59-4.846c1.62.962 3.21 1.454 4.808 1.455 5.518 0 10.011-4.49 10.014-10.011.002-2.675-1.03-5.19-2.906-7.07C16.69 1.648 14.183.618 11.517.618 6.002.618 1.506 5.114 1.503 10.638c-.001 1.685.462 3.329 1.341 4.774L1.83 20.88l5.962-1.564zM18.01 14.92c-.29-.145-1.72-.85-1.987-.947-.266-.097-.46-.145-.654.145-.193.29-.75.947-.92 1.142-.168.193-.338.217-.627.072-2.222-1.11-3.64-2.032-5.1-4.542-.29-.497.29-.462.83-1.542.09-.193.045-.362-.023-.507-.068-.145-.654-1.576-.897-2.155-.236-.57-.478-.49-.654-.5-.17-.008-.362-.01-.555-.01-.193 0-.507.072-.773.362-.266.29-1.014.99-1.014 2.415 0 1.425 1.038 2.8 1.183 2.993.145.193 2.04 3.115 4.94 4.372 2.9.125 3.49.1 4.72.015.63-.043 1.72-.7 1.96-1.376.24-.677.24-1.256.17-1.376-.073-.12-.266-.193-.556-.338z" />
            </svg>
          </div>

          <!-- Texto Alinhado à esquerda -->
          <div class="flex-grow px-4 text-left">
            <span class="block text-sm font-bold tracking-wide leading-tight text-white font-sans">Solicite seu projeto personalizado</span>
          </div>

          <!-- Seta Indicadora Lado Direito -->
          <div class="text-white/60 group-hover:text-white group-hover:translate-x-1 transition-all duration-300 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </a>

      </main>

      <!-- Divisor Sutil -->
      <div class="w-full max-w-[360px] h-[1px] bg-slate-100 animate-fade-in-up delay-450 mb-6"></div>

      <!-- Rodapé do Card (Info) -->
      <footer class="w-full max-w-[360px] flex flex-col items-center animate-fade-in-up delay-500">
        <!-- Indicador de Cobertura -->
        <div class="flex items-center justify-center gap-1.5 mb-2 text-red-500/90 w-full">
          <!-- Ícone de Pin de Localização Vermelho -->
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 fill-current animate-bounce shrink-0" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
          </svg>
          <span class="text-xs font-bold text-slate-800 uppercase tracking-widest font-sans text-center">
            Equipes em Campo Grande e Dourados — Atendemos todo MS
          </span>
        </div>
        
        <p class="text-xs text-slate-500 font-medium leading-relaxed font-sans px-2 text-center">
          Atendimento especializado em todo o Mato Grosso do Sul com agilidade e qualidade.
        </p>
      </footer>

    </div>
  </div>
</Layout>

<style is:global>
  /* Configuração do Layout e Fundo */
  .grid-pattern {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(to right, rgba(11, 30, 54, 0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(11, 30, 54, 0.03) 1px, transparent 1px);
    background-size: 20px 20px;
    pointer-events: none;
  }

  .radial-fade {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(29, 78, 216, 0.03) 0%, rgba(248, 250, 252, 0.95) 70%);
    pointer-events: none;
  }

  /* Card Container */
  .linktree-card {
    position: relative;
    width: 100%;
    max-width: 440px;
    background-color: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 28px;
    box-shadow: 0 15px 35px rgba(11, 30, 54, 0.06);
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 10;
  }

  @media (max-width: 640px) {
    .linktree-card {
      padding: 2rem 1.25rem;
    }
  }

  /* Estilização dos Botões - Cantos arredondados, cor sólida azul escuro, texto branco */
  .btn-linktree {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 360px;
    margin-left: auto;
    margin-right: auto;
    padding: 1rem 1.25rem;
    text-decoration: none;
    box-sizing: border-box;
  }

  /* Wrapper para ícones à esquerda - Fundo transparente, integrado */
  .btn-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    flex-shrink: 0;
  }

  /* Animações de Entrada Staggered */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    opacity: 0;
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .delay-100 { animation-delay: 80ms; }
  .delay-200 { animation-delay: 160ms; }
  .delay-300 { animation-delay: 240ms; }
  .delay-400 { animation-delay: 320ms; }
  .delay-450 { animation-delay: 380ms; }
  .delay-500 { animation-delay: 440ms; }
</style>
