---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="A Super Telas agora é Maufe Telas" 
  description="A Super Telas agora é Maufe Telas. Acesse nosso site e conheça nossas soluções em redes de proteção e telas mosquiteiras sob medida."
  robots="noindex, nofollow"
>
  <div class="min-h-screen flex flex-col justify-between bg-gradient-to-b from-brand-light/60 via-brand-light/30 to-white relative overflow-hidden font-sans">
    
    <!-- Elementos Decorativos de Fundo para Profundidade Visual -->
    <div class="absolute top-[-20%] left-[-10%] w-[600px] h-[600px] rounded-full bg-brand-blue/5 blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-[-10%] right-[-10%] w-[500px] h-[500px] rounded-full bg-brand-green/5 blur-[100px] pointer-events-none"></div>

    <!-- Espaçador Superior para centralização ótica balanceada -->
    <div></div>

    <!-- Conteúdo Centralizado -->
    <main class="w-full max-w-2xl mx-auto px-6 py-12 flex flex-col items-center text-center z-10">
      
      <!-- Container do Logo com Animação -->
      <div class="animate-fade-in-down opacity-0 select-none" style="animation-delay: 100ms; animation-fill-mode: forwards;">
        <img 
          src="/referencias/imagens/C_Logo-Maufe-600px.png" 
          alt="Logo Maufe Telas" 
          class="h-16 sm:h-20 w-auto object-contain drop-shadow-[0_4px_12px_rgba(11,30,54,0.04)]"
          draggable="false"
        />
      </div>

      <!-- Caixa de Transição / Badge de marca -->
      <div class="mt-8 animate-fade-in-up opacity-0 inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-brand-blue/10 border border-brand-blue/20 text-xs font-bold uppercase tracking-wider text-brand-blue" style="animation-delay: 300ms; animation-fill-mode: forwards;">
        Comunicado de Transição
      </div>

      <!-- Título Principal com Animação -->
      <h1 class="mt-6 text-3xl sm:text-4xl md:text-5xl font-black text-brand-dark tracking-tight leading-tight font-display animate-fade-in-up opacity-0" style="animation-delay: 500ms; animation-fill-mode: forwards;">
        A Super Telas agora é <span class="text-brand-blue">Maufe Telas</span>
      </h1>

      <!-- Texto de Apoio Explicativo -->
      <p class="mt-6 text-base sm:text-lg text-brand-dark/70 font-medium leading-relaxed max-w-lg animate-fade-in-up opacity-0" style="animation-delay: 700ms; animation-fill-mode: forwards;">
        Unificamos nossas marcas para trazer uma experiência ainda mais completa, com a mesma qualidade de instalação e a proteção que você já confia.
      </p>

      <!-- Botão Call to Action (CTA) -->
      <div class="mt-10 animate-fade-in-up opacity-0" style="animation-delay: 900ms; animation-fill-mode: forwards;">
        <a 
          href="/" 
          class="inline-flex items-center justify-center px-8 py-4 text-base font-bold text-white bg-brand-blue hover:bg-brand-blue/95 rounded-xl shadow-[0_8px_30px_rgb(29,78,216,0.3)] hover:shadow-[0_12px_35px_rgb(29,78,216,0.4)] transition-all duration-300 transform hover:-translate-y-0.5 active:translate-y-0 active:scale-98 group cursor-pointer"
        >
          Acessar Site da Maufe Telas
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>

    </main>

    <!-- Rodapé Minimalista -->
    <footer class="w-full text-center py-8 z-10 animate-fade-in opacity-0" style="animation-delay: 1100ms; animation-fill-mode: forwards;">
      <p class="text-xs text-brand-dark/40 font-medium">
        &copy; {new Date().getFullYear()} Maufe Telas. Todos os direitos reservados.
      </p>
    </footer>

  </div>
</Layout>

<style>
  /* Animações CSS Customizadas */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeInDown {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .animate-fade-in-down {
    animation: fadeInDown 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .animate-fade-in {
    animation: fadeIn 1s ease-out;
  }
</style>
