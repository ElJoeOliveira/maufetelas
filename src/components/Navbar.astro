---
---

<!-- Elemento externo: posicionamento fixo no topo -->
<header id="navbar-wrapper" class="fixed top-0 left-0 right-0 z-50 px-0 pt-0 transition-all duration-500">
  
  <!-- Elemento interno: visual transparente inicial que transiciona no scroll -->
  <div 
    id="navbar" 
    class="mx-auto w-full max-w-7xl bg-transparent border border-transparent shadow-none transition-all duration-500"
  >
    <div class="px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-20">
        
        <!-- Logo -->
        <a href="#home" class="flex items-center gap-2 group shrink-0">
          <img 
            src="/referencias/imagens/C_Logo-Maufe-600px.png" 
            alt="Maufe Telas" 
            class="h-10 sm:h-12 w-auto object-contain transition-all duration-300"
          />
        </a>

        <!-- Links de Navegação - Desktop -->
        <nav class="hidden md:flex items-center gap-8">
          <a href="#home" class="nav-link text-sm font-medium text-white/90 hover:text-white transition-colors relative after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-0.5 after:bg-brand-blue after:transition-all hover:after:w-full">
            Início
          </a>
          <a href="#solucoes" class="nav-link text-sm font-medium text-white/90 hover:text-white transition-colors relative after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-0.5 after:bg-brand-blue after:transition-all hover:after:w-full">
            Soluções
          </a>
          <a href="#depoimentos" class="nav-link text-sm font-medium text-white/90 hover:text-white transition-colors relative after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-0.5 after:bg-brand-blue after:transition-all hover:after:w-full">
            Depoimentos
          </a>
          <a href="#clientes" class="nav-link text-sm font-medium text-white/90 hover:text-white transition-colors relative after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-0.5 after:bg-brand-blue after:transition-all hover:after:w-full">
            Clientes
          </a>
          <a href="#faq" class="nav-link text-sm font-medium text-white/90 hover:text-white transition-colors relative after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-0.5 after:bg-brand-blue after:transition-all hover:after:w-full">
            Dúvidas
          </a>
        </nav>

        <!-- CTA Botão - Desktop -->
        <div class="hidden md:flex items-center">
          <a 
            id="nav-cta"
            href="https://api.whatsapp.com/send?phone=5567991355250&text=%5BM0%5D%20Ol%C3%A1%2C%20gostaria%20de%20mais%20informa%C3%A7%C3%B5es%20sobre%20as%20Telas." 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-semibold text-white border border-white hover:bg-white hover:text-brand-dark rounded-lg transition-all duration-300 transform active:scale-98"
          >
            Projeto Personalizado
          </a>
        </div>

        <!-- Botão Menu Mobile -->
        <div class="flex md:hidden">
          <button 
            type="button" 
            id="mobile-menu-btn" 
            class="text-white hover:text-brand-blue p-2 rounded-md transition-colors"
            aria-label="Abrir menu"
          >
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>

      </div>
    </div>

    <!-- Menu Mobile Dropdown -->
    <div 
      id="mobile-menu" 
      class="hidden md:hidden border-t border-gray-100 bg-white/98 transition-all duration-300"
    >
      <div class="px-4 pt-2 pb-6 space-y-3 shadow-inner">
        <a href="#home" class="mobile-nav-link block px-3 py-2 text-base font-medium text-brand-dark hover:bg-brand-light hover:text-brand-blue rounded-md transition-all">
          Início
        </a>
        <a href="#solucoes" class="mobile-nav-link block px-3 py-2 text-base font-medium text-brand-dark hover:bg-brand-light hover:text-brand-blue rounded-md transition-all">
          Soluções
        </a>
        <a href="#depoimentos" class="mobile-nav-link block px-3 py-2 text-base font-medium text-brand-dark hover:bg-brand-light hover:text-brand-blue rounded-md transition-all">
          Depoimentos
        </a>
        <a href="#clientes" class="mobile-nav-link block px-3 py-2 text-base font-medium text-brand-dark hover:bg-brand-light hover:text-brand-blue rounded-md transition-all">
          Clientes
        </a>
        <a href="#faq" class="mobile-nav-link block px-3 py-2 text-base font-medium text-brand-dark hover:bg-brand-light hover:text-brand-blue rounded-md transition-all">
          Dúvidas
        </a>
        <div class="pt-4 px-3">
          <a 
            href="https://api.whatsapp.com/send?phone=5567991355250&text=%5BM0%5D%20Ol%C3%A1%2C%20gostaria%20de%20mais%20informa%C3%A7%C3%B5es%20sobre%20as%20Telas." 
            target="_blank" 
            rel="noopener noreferrer" 
            class="w-full inline-flex items-center justify-center px-4 py-3 text-base font-semibold text-white bg-brand-blue hover:bg-brand-blue/90 rounded-lg shadow-sm transition-all text-center"
          >
            Projeto Personalizado
          </a>
        </div>
      </div>
    </div>

  </div>
</header>

<script>
  // Comportamento do Scroll da Navbar (conforme diretrizes_navbar.md)
  const wrapper = document.getElementById('navbar-wrapper');
  const navbar  = document.getElementById('navbar');
  const navLinks = document.querySelectorAll('.nav-link');
  const navCta = document.getElementById('nav-cta');
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');

  if (wrapper && navbar) {
    const handleScroll = () => {
      if (window.scrollY > 50) {
        // Estado Scrolled (Com fundo branco glass e largura contida)
        navbar.classList.remove('max-w-7xl', 'border-transparent', 'bg-transparent', 'shadow-none');
        navbar.classList.add(
          'max-w-[1200px]',
          'bg-white/90',
          'backdrop-blur-xl',
          'border-brand-blue/20',
          'shadow-[0_10px_30px_rgba(11,30,54,0.08)]',
          'rounded-2xl'
        );
        wrapper.classList.add('pt-3', 'px-4');
        wrapper.classList.remove('pt-0');

        // Mudar cor dos links para escuro
        navLinks.forEach(link => {
          link.classList.remove('text-white/90', 'hover:text-white');
          link.classList.add('text-brand-dark', 'hover:text-brand-blue');
        });

        // Mudar estilo do CTA
        if (navCta) {
          navCta.classList.remove('text-white', 'border-white', 'hover:bg-white', 'hover:text-brand-dark');
          navCta.classList.add('text-brand-blue', 'border-brand-blue', 'hover:bg-brand-blue', 'hover:text-white');
        }

        // Mudar cor do botão mobile
        if (mobileMenuBtn) {
          mobileMenuBtn.classList.remove('text-white');
          mobileMenuBtn.classList.add('text-brand-dark');
        }
      } else {
        // Estado Inicial (No topo, transparente sobre fundo escuro do Hero)
        navbar.classList.add('max-w-7xl', 'border-transparent', 'bg-transparent', 'shadow-none');
        navbar.classList.remove(
          'max-w-[1200px]',
          'bg-white/90',
          'backdrop-blur-xl',
          'border-brand-blue/20',
          'shadow-[0_10px_30px_rgba(11,30,54,0.08)]',
          'rounded-2xl'
        );
        wrapper.classList.remove('pt-3', 'px-4');
        wrapper.classList.add('pt-0');

        // Mudar cor dos links para claro
        navLinks.forEach(link => {
          link.classList.remove('text-brand-dark', 'hover:text-brand-blue');
          link.classList.add('text-white/90', 'hover:text-white');
        });

        // Mudar estilo do CTA
        if (navCta) {
          navCta.classList.remove('text-brand-blue', 'border-brand-blue', 'hover:bg-brand-blue', 'hover:text-white');
          navCta.classList.add('text-white', 'border-white', 'hover:bg-white', 'hover:text-brand-dark');
        }

        // Mudar cor do botão mobile
        if (mobileMenuBtn) {
          mobileMenuBtn.classList.remove('text-brand-dark');
          mobileMenuBtn.classList.add('text-white');
        }
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    // Executar uma vez no carregamento para posicionamento correto
    handleScroll();
  }

  // Toggle do Menu Mobile
  const mobileMenu = document.getElementById('mobile-menu');

  if (mobileMenuBtn && mobileMenu) {
    mobileMenuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    // Fechar menu mobile ao clicar em um link
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
      });
    });
  }
</script>
