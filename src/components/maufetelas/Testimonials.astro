---
import reviews from '../../data/reviews-google.json';

const formattedReviews = reviews.map(review => {
  const date = new Date(review.publishedAtDate);
  const formattedDate = date.toLocaleDateString('pt-BR', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  });
  return {
    ...review,
    formattedDate
  };
});
---

<section id="depoimentos" class="bg-white py-20 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    <!-- Cabeçalho Principal -->
    <div class="flex flex-col items-center justify-center text-center space-y-4">
      <div class="flex flex-col items-center gap-2">
        <!-- Ícone do Google clássico e colorido para autoridade máxima -->
        <svg class="h-10 w-10" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
        </svg>
        <div class="flex gap-1 text-yellow-400">
          {Array.from({ length: 5 }).map(() => (
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 fill-current" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))}
        </div>
      </div>

      <h2 class="text-3xl md:text-4xl font-extrabold font-display text-brand-dark tracking-tight uppercase">
        O que dizem nossos clientes
      </h2>
      <p class="text-base text-gray-600 max-w-xl font-medium">
        Somos avaliados com 5 estrelas no Google Meu Negócio. Transparência e compromisso com cada família atendida.
      </p>
    </div>

    <!-- Grade de Testemunhos -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {formattedReviews.map((review, index) => (
        <div 
          class="review-card bg-brand-light p-6 rounded-2xl border border-brand-blue/5 shadow-sm hover:shadow-md hover:border-brand-blue/15 transition-all duration-300 flex flex-col justify-between h-[300px] relative overflow-hidden"
          data-index={index}
        >
          <!-- Aspas decorativas no fundo -->
          <span class="absolute -top-4 right-6 text-brand-blue/5 text-8xl font-serif pointer-events-none select-none">“</span>
          
          <div class="flex flex-col flex-grow overflow-hidden">
            <!-- Cabeçalho: Foto, Nome e Link do Google -->
            <div class="flex items-center justify-between gap-3 pb-3 border-b border-gray-200/50">
              <div class="flex items-center gap-3">
                {review.reviewerPhotoUrl ? (
                  <img 
                    src={review.reviewerPhotoUrl} 
                    alt={`Foto de ${review.name}`} 
                    class="w-10 h-10 rounded-full object-cover border border-gray-200" 
                    referrerpolicy="no-referrer"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-10 h-10 rounded-full bg-brand-blue/10 flex items-center justify-center text-brand-blue font-bold text-sm font-display">
                    {review.name.substring(0, 2).toUpperCase()}
                  </div>
                )}
                <div>
                  <h4 class="text-sm font-bold text-brand-dark font-display leading-tight">{review.name}</h4>
                  <p class="text-xs text-gray-400">{review.formattedDate}</p>
                </div>
              </div>
              
              <!-- Link da avaliação com ícone do Google clássico e colorido -->
              <a 
                href={review.reviewUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                title="Ver avaliação original no Google"
                class="transition-transform hover:scale-110 p-1 flex items-center justify-center shrink-0"
              >
                <svg class="h-5 w-5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                  <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                  <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
                  <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
                </svg>
              </a>
            </div>

            <!-- Estrelas -->
            <div class="flex gap-0.5 text-yellow-400 pt-3">
              {Array.from({ length: review.stars }).map(() => (
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>

            <!-- Corpo de texto -->
            <div class="review-text-container relative flex-grow overflow-hidden mt-3">
              <p class="review-text text-sm text-gray-600 italic font-sans leading-relaxed line-clamp-4">
                "{review.text}"
              </p>
            </div>
          </div>

          <!-- Rodapé do Card: Botão de Expansão (Oculto por padrão, ativado via JS) -->
          <div class="expand-btn-container pt-3 border-t border-gray-200/50 hidden">
            <button class="expand-btn w-full text-left text-xs font-semibold text-brand-blue hover:text-brand-blue/80 transition-colors focus:outline-none flex items-center gap-1">
              <span>Ler Relato Completo</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 transform transition-transform duration-200 btn-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  function setupTestimonials() {
    const cards = document.querySelectorAll('.review-card');
    
    cards.forEach(card => {
      const htmlCard = card as HTMLElement;
      const textContainer = htmlCard.querySelector('.review-text-container') as HTMLElement;
      const textParagraph = htmlCard.querySelector('.review-text') as HTMLElement;
      const btnContainer = htmlCard.querySelector('.expand-btn-container') as HTMLElement;
      const btn = htmlCard.querySelector('.expand-btn') as HTMLButtonElement;
      const arrow = htmlCard.querySelector('.btn-arrow') as SVGElement;
      
      if (!textContainer || !textParagraph || !btnContainer || !btn || !arrow) return;
      
      // Armazena a altura de scroll atual com line-clamp ativo e depois inativo para comparar
      const originalHeight = textParagraph.clientHeight;
      
      // Remove temporariamente o line-clamp para checar se há overflow real
      textParagraph.classList.remove('line-clamp-4');
      const fullHeight = textParagraph.clientHeight;
      
      // Re-adiciona a limitação padrão
      textParagraph.classList.add('line-clamp-4');
      
      // Se a altura cheia for maior que a altura com limite, exibe o botão
      if (fullHeight > originalHeight) {
        btnContainer.classList.remove('hidden');
      }
      
      btn.addEventListener('click', () => {
        const isExpanded = htmlCard.classList.contains('is-expanded');
        
        if (isExpanded) {
          // Colapsar card
          htmlCard.classList.remove('is-expanded');
          htmlCard.style.height = '300px';
          textParagraph.classList.add('line-clamp-4');
          arrow.classList.remove('rotate-180');
          const btnText = btn.querySelector('span');
          if (btnText) btnText.textContent = 'Ler Relato Completo';
        } else {
          // Expandir card
          htmlCard.classList.add('is-expanded');
          htmlCard.style.height = 'auto';
          textParagraph.classList.remove('line-clamp-4');
          arrow.classList.add('rotate-180');
          const btnText = btn.querySelector('span');
          if (btnText) btnText.textContent = 'Mostrar Menos';
        }
      });
    });
  }

  // Executa no carregamento inicial da página
  document.addEventListener('DOMContentLoaded', setupTestimonials);
  
  // Executa em transições de página caso use bibliotecas de navegação dinâmica (SPA/Astro Swup)
  document.addEventListener('astro:page-load', setupTestimonials);
</script>
