---
---

<section class="relative bg-brand-dark overflow-hidden min-h-[500px] flex items-center">
  <!-- Grid Split: Texto no lado esquerdo, Imagem no lado direito em telas grandes -->
  <div class="absolute inset-0 z-0">
    <!-- Imagem em overlay para mobile/tablet -->
    <img 
      src="/referencias/imagens/CriancaGato3.jpg.webp" 
      alt="Criança e gato seguros em casa" 
      class="w-full h-full object-cover object-center lg:hidden opacity-25"
    />
  </div>

  <!-- Metade direita com a imagem estilizada (apenas lg:) -->
  <div class="hidden lg:block absolute right-0 top-0 bottom-0 w-1/2 z-1">
    <div class="relative w-full h-full">
      <img 
        src="/referencias/imagens/CriancaGato3.jpg.webp" 
        alt="Criança e gato seguros em casa" 
        class="w-full h-full object-cover object-center"
      />
      <!-- Máscara de transição em degradê diagonal para mesclar com o fundo escuro -->
      <div class="absolute inset-0 bg-gradient-to-r from-brand-dark via-brand-dark/20 to-transparent"></div>
    </div>
  </div>

  <!-- Conteúdo em primeiro plano -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full py-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- Bloco de Texto (ocupa 100% no mobile, 50% no desktop) -->
      <div class="lg:col-span-6 space-y-6 text-white text-center lg:text-left">
        
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-blue/20 border border-brand-blue/40 text-brand-blue text-xs font-semibold tracking-wide uppercase">
          Decisão Inteligente
        </span>

        <h2 class="text-4xl sm:text-5xl font-extrabold font-display leading-[1.15] tracking-tight">
          O que realmente <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-blue to-cyan-300">importa</span>!
        </h2>

        <p class="text-lg text-gray-300 font-sans leading-relaxed max-w-xl mx-auto lg:mx-0">
          Proteção para os pequenos mais importantes da nossa vida. Não deixe a segurança da sua família para depois. Proteja hoje mesmo quem você mais ama!
        </p>

        <!-- CTA Principal de Alto Impacto -->
        <div class="pt-4">
          <a 
            href="https://api.whatsapp.com/send?phone=5567991355250&text=%5BM4%5D%20Ol%C3%A1%2C%20gostaria%20de%20mais%20informa%C3%A7%C3%B5es%20sobre%20as%20Telas." 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center justify-center gap-3 px-8 py-5 text-base sm:text-lg font-bold text-white bg-brand-blue hover:bg-brand-blue/95 hover:shadow-[0_0_35px_rgba(29,78,216,0.55)] hover:scale-102 rounded-2xl transition-all duration-300 group cursor-pointer shadow-lg"
          >
            <!-- Ícone WhatsApp -->
            <svg class="h-6 w-6 fill-current transition-transform group-hover:rotate-12" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.454 5.709 1.455h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            QUERO PROTEGER MINHA FAMÍLIA AGORA
          </a>
        </div>
        
        <!-- Benefícios de redução de objeção rápidos -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-6 pt-4 text-xs text-gray-400">
          <div class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-brand-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            Instalação Limpa e Rápida
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-brand-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            Orçamento Rápido e Grátis
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-brand-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            Facilidade no WhatsApp
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
