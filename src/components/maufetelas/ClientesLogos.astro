---
const clientesLogos = [
  { src: "/referencias/clientes/Cassems.jpg.webp", alt: "Cassems" },
  { src: "/referencias/clientes/Delirio.jpg.webp", alt: "Delírio" },
  { src: "/referencias/clientes/Eletrobras.jpg.webp", alt: "Eletrobras" },
  { src: "/referencias/clientes/Elite.jpg.webp", alt: "Elite" },
  { src: "/referencias/clientes/Estoril.jpg.webp", alt: "Estoril" },
  { src: "/referencias/clientes/Paris6.jpg.webp", alt: "Paris 6" },
  { src: "/referencias/clientes/IFMS.jpg.webp", alt: "IFMS" },
  { src: "/referencias/clientes/Funcional.jpg.webp", alt: "Funcional" },
  { src: "/referencias/clientes/Hook.jpg.webp", alt: "Hook" },
  { src: "/referencias/clientes/Ponto-alto.jpg.webp", alt: "Ponto Alto" },
  { src: "/referencias/clientes/QuartaIgreja.jpg.webp", alt: "Quarta Igreja" },
  { src: "/referencias/clientes/NascenteAzul.jpg.webp", alt: "Nascente Azul" }
];
---

<section id="clientes" class="bg-brand-light py-20 overflow-hidden relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    <div class="text-center space-y-4 max-w-3xl mx-auto">
      <span class="text-xs font-semibold tracking-wider text-brand-blue uppercase bg-brand-blue/10 px-3 py-1 rounded-full">
        Parcerias Comerciais
      </span>
      <h2 class="text-3xl md:text-4xl font-extrabold font-display text-brand-dark tracking-tight">
        Quem já se protegeu conosco
      </h2>
      <p class="text-base text-gray-600">
        Empresas, indústrias, instituições de ensino, órgãos públicos, bares e restaurantes que contam com a qualidade e segurança da Maufe Telas.
      </p>
    </div>

    <!-- Marquee de Logos de Clientes -->
    <div class="flex overflow-hidden w-full relative z-10 select-none">
      <div class="flex gap-10 items-center animate-marquee whitespace-nowrap hover:[animation-play-state:paused] py-4">
        {clientesLogos.map((logo) => (
          <div class="inline-flex w-44 h-44 sm:w-52 sm:h-52 shrink-0 bg-white p-6 rounded-3xl shadow-md border border-gray-100 items-center justify-center group transition-all duration-300">
            <img 
              src={logo.src} 
              alt={logo.alt} 
              title={logo.alt}
              class="max-w-full max-h-full object-contain filter grayscale opacity-90 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-300"
            />
          </div>
        ))}
        <!-- Duplicado para loop contínuo -->
        {clientesLogos.map((logo) => (
          <div class="inline-flex w-44 h-44 sm:w-52 sm:h-52 shrink-0 bg-white p-6 rounded-3xl shadow-md border border-gray-100 items-center justify-center group transition-all duration-300">
            <img 
              src={logo.src} 
              alt={logo.alt} 
              title={logo.alt}
              class="max-w-full max-h-full object-contain filter grayscale opacity-90 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-300"
            />
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  @keyframes marquee {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .animate-marquee {
    animation: marquee 38s linear infinite;
  }
</style>
