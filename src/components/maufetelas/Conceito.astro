<section class="py-16 md:py-20 bg-brand-light relative overflow-hidden flex items-center justify-center">
  <!-- Elementos de design abstratos de fundo -->
  <div class="absolute top-1/2 left-10 w-72 h-72 bg-brand-blue/5 rounded-full blur-3xl pointer-events-none -translate-y-1/2"></div>
  <div class="absolute top-1/2 right-10 w-72 h-72 bg-brand-blue/5 rounded-full blur-3xl pointer-events-none -translate-y-1/2"></div>

  <div class="max-w-4xl mx-auto px-4 text-center relative z-10 space-y-6">
    <!-- Ícone decorativo premium (Mãos protegendo um coração em linhas finas) -->
    <div class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-white text-brand-blue shadow-md border border-brand-blue/10 mb-2 transform hover:scale-105 transition-transform duration-300">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
      </svg>
    </div>

    <!-- Título Emocional Principal -->
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold font-display text-brand-dark tracking-tight leading-tight">
      Carinho e proteção para o seu lar
    </h2>

    <!-- Divisor decorativo -->
    <div class="w-16 h-1 bg-gradient-to-r from-brand-blue to-cyan-400 mx-auto rounded-full"></div>

    <!-- Subtexto -->
    <p class="text-base sm:text-lg text-gray-600 max-w-2xl mx-auto font-sans leading-relaxed">
      Sabemos que sua casa é o seu porto seguro. Por isso, oferecemos mais do que telas e redes: entregamos a tranquilidade de saber que seus filhos, pets e familiares estão totalmente protegidos, com o cuidado técnico que eles merecem.
    </p>
  </div>
</section>
