---
---

<footer class="bg-brand-dark text-gray-300 pt-16 pb-8 border-t border-brand-dark/20 relative overflow-hidden">
  <!-- Efeito visual decorativo de fundo -->
  <div class="absolute -right-24 -bottom-24 w-96 h-96 bg-brand-blue/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      
      <!-- Coluna 1: Logo e Descrição Curta -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <img 
            src="/referencias/imagens/C_Logo-Maufe-Quadrada-300x300.png.webp" 
            alt="Maufe Telas" 
            class="h-12 w-auto brightness-0 invert"
          />
          <div>
            <span class="text-xl font-bold font-display text-white tracking-wide block">MAUFE TELAS</span>
            <span class="text-xs text-gray-400 block tracking-wider uppercase">Redes & Telas</span>
          </div>
        </div>
        <p class="text-sm text-gray-400 max-w-sm">
          Proteção real para quem você mais ama. Redes de proteção certificadas e telas mosquiteiras sob medida instaladas por profissionais qualificados em todo o Mato Grosso do Sul.
        </p>
      </div>

      <!-- Coluna 2: Informações de Contato -->
      <div class="space-y-4">
        <h3 class="text-white font-semibold text-lg font-display tracking-wide border-b border-gray-800 pb-2">Contato</h3>
        <ul class="space-y-3 text-sm text-gray-400">
          <li class="flex items-center gap-2">
            <!-- Ícone oficial do WhatsApp -->
            <svg class="h-4 w-4 text-brand-blue shrink-0 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.454 5.709 1.455h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            <a href="https://api.whatsapp.com/send?phone=5567991355250&text=%5BM0%5D%20Ol%C3%A1%2C%20gostaria%20de%20mais%20informa%C3%A7%C3%B5es%20sobre%20as%20Telas." target="_blank" class="hover:text-brand-blue transition-colors">
              (67) 9 9135-5250
            </a>
          </li>
          <li class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-brand-blue shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href="mailto:cmaufetelas@gmail.com" class="hover:text-brand-blue transition-colors">
              maufetelas@gmail.com
            </a>
          </li>
          <li class="text-xs text-gray-500 pt-2 block">
            CNPJ: 44.776.352/0001-09
          </li>
        </ul>
      </div>

      <!-- Coluna 3: Navegação Rápida (Selo de Segurança SSL Removido) -->
      <div class="space-y-4">
        <h3 class="text-white font-semibold text-lg font-display tracking-wide border-b border-gray-800 pb-2">Navegação</h3>
        <ul class="space-y-3 text-sm text-gray-400">
          <li>
            <a href="#home" class="hover:text-brand-blue transition-colors flex items-center gap-2 group">
              Voltar ao Topo
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 transform group-hover:-translate-y-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
              </svg>
            </a>
          </li>
          <li>
            <a href="#solucoes" class="hover:text-brand-blue transition-colors">Nossas Soluções</a>
          </li>
          <li>
            <a href="#depoimentos" class="hover:text-brand-blue transition-colors">Depoimentos</a>
          </li>
          <li>
            <a href="#faq" class="hover:text-brand-blue transition-colors">Dúvidas Frequentes</a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Divisor Inferior -->
    <div class="border-t border-gray-800/80 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-gray-500">
      
      <!-- Links de Termos e Privacidade -->
      <div class="flex items-center gap-4">
        <a 
          href="/politica-de-privacidade" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="hover:text-white transition-colors"
        >
          Política de Privacidade
        </a>
        <span class="text-gray-700">|</span>
        <a 
          href="/termos-de-uso" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="hover:text-white transition-colors"
        >
          Termos de Uso
        </a>
      </div>

      <!-- Direitos Autorais e Créditos -->
      <div class="text-center md:text-right space-y-1">
        <p>&copy; {new Date().getFullYear()} Maufe Telas. Todos os direitos reservados.</p>
        <p>
          Desenvolvido por 
          <a 
            href="https://anunciecerto.com.br/" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="transition-colors hover:opacity-90 font-medium"
            style="color: #ff9900;"
          >
            Anuncie Certo
          </a>
        </p>
      </div>

    </div>
  </div>
</footer>
