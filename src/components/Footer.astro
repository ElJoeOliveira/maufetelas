---
---

<footer class="bg-brand-dark text-gray-300 pt-16 pb-8 border-t border-brand-dark/20 relative overflow-hidden">
  <!-- Efeito visual decorativo de fundo -->
  <div class="absolute -right-24 -bottom-24 w-96 h-96 bg-brand-blue/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      
      <!-- Coluna 1: Logo e Descrição Curta -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <img 
            src="/referencias/imagens/C_Logo-Maufe-Quadrada-300x300.png.webp" 
            alt="Maufe Telas" 
            class="h-12 w-auto brightness-0 invert"
          />
          <div>
            <span class="text-xl font-bold font-display text-white tracking-wide block">MAUFE TELAS</span>
            <span class="text-xs text-gray-400 block tracking-wider uppercase">Redes & Telas</span>
          </div>
        </div>
        <p class="text-sm text-gray-400 max-w-sm">
          Proteção real para quem você mais ama. Redes de proteção certificadas e telas mosquiteiras sob medida instaladas por profissionais qualificados em todo o Mato Grosso do Sul.
        </p>
      </div>

      <!-- Coluna 2: Informações de Contato -->
      <div class="space-y-4">
        <h3 class="text-white font-semibold text-lg font-display tracking-wide border-b border-gray-800 pb-2">Contato</h3>
        <ul class="space-y-3 text-sm text-gray-400">
          <li class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-brand-blue shrink-0" fill="none" viewBox="24 24" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href="https://api.whatsapp.com/send?phone=5567991355250&text=%5BM0%5D%20Ol%C3%A1%2C%20gostaria%20de%20mais%20informa%C3%A7%C3%B5es%20sobre%20as%20Telas." target="_blank" class="hover:text-brand-blue transition-colors">
              (67) 9 9135-5250
            </a>
          </li>
          <li class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-brand-blue shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href="mailto:contato@maufetelas.com.br" class="hover:text-brand-blue transition-colors">
              contato@maufetelas.com.br
            </a>
          </li>
          <li class="text-xs text-gray-500 pt-2 block">
            CNPJ: 44.776.352/0001-09
          </li>
        </ul>
      </div>

      <!-- Coluna 3: Selo de Segurança e Links Rápidos -->
      <div class="space-y-4">
        <h3 class="text-white font-semibold text-lg font-display tracking-wide border-b border-gray-800 pb-2">Segurança</h3>
        <div class="space-y-4">
          <img 
            src="/referencias/imagens/C_SSLSeguro-300x50.png" 
            alt="SSL Seguro" 
            class="max-w-[180px] h-auto object-contain brightness-95 hover:brightness-100 transition-all"
          />
          <div class="pt-2">
            <a 
              href="#home" 
              class="inline-flex items-center gap-2 text-xs text-gray-400 hover:text-white transition-colors group"
            >
              Voltar ao topo
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 h-3 transform group-hover:-translate-y-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
              </svg>
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Divisor Inferior -->
    <div class="border-t border-gray-800/80 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-gray-500">
      
      <!-- Links de Termos e Privacidade -->
      <div class="flex items-center gap-4">
        <a 
          href="/politica-de-privacidade" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="hover:text-white transition-colors"
        >
          Política de Privacidade
        </a>
        <span class="text-gray-700">|</span>
        <a 
          href="/termos-de-uso" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="hover:text-white transition-colors"
        >
          Termos de Uso
        </a>
      </div>

      <!-- Direitos Autorais e Créditos -->
      <div class="text-center md:text-right space-y-1">
        <p>&copy; {new Date().getFullYear()} Maufe Telas. Todos os direitos reservados.</p>
        <p>
          Desenvolvido por 
          <a 
            href="https://anunciecerto.com.br/" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="transition-colors hover:opacity-90 font-medium"
            style="color: #ff9900;"
          >
            Anuncie Certo
          </a>
        </p>
      </div>

    </div>
  </div>
</footer>
